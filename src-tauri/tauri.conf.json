{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Settings",
  "version": "0.2.1",
  "identifier": "com.claudesettings.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Code Settings",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1MDEzNDI4Njg0NzM1RDgKUldUWU5VZG9LRFFCUmRHeGo2clY4U3YybzNHSGs2SzFyVWhySkZQNzM1empTSnRYOUVHSVErb2gK",
      "endpoints": [
        "https://github.com/yuese12333/claude-settings-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
